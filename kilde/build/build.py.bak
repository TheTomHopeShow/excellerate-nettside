 case("thon","Thon Hotels: et kommersielt kulturløft","Pipeline økte fra 92 til 124 millioner kroner. Omsetningen vokste 5 prosent.","Kilde: excellerate.no, 2018")+
 case("bolig","BoligPartner: leder- og salgsutvikling","I 2014 falt bransjen 22 prosent. BoligPartner vokste 26 prosent. Treffprosenten økte fra 28 til 42,5.","Kilde: excellerate.no, 2014")+
 case("wik","Wikborg Rein: forenklet kompetanseutvikling","Alle advokater i Norge fikk opplæring i informasjonssikkerhet på 14 dager.","Kilde: excellerate.no, 2018"))
SEP='<div class="vsep" aria-hidden="true"></div>'
fs=fs.replace("@@TOG@@","".join(excard(e) for e in LED)+SEP+"".join(excard(e) for e in EXP))
