</div>
<div class="g4" style="margin-top:40px;row-gap:32px">
<sc-for list="{{kort}}" as="e" hint-placeholder-count="8">
<sc-if value="{{e.vis}}" hint-placeholder-val="{{true}}">
<a class="ex" href="Fagekspert.dc.html"><div class="pt"><div class="pi"><img src="{{e.bilde}}" alt="{{e.navn}}"></div><span class="dot"></span></div><div class="tx"><h3>{{e.navn}}</h3><p class="r">{{e.rolle}}</p><p class="t">{{e.tekst}}</p></div><span class="lk"><span class="lesl">Les mer<span class="pil"></span></span></span></a>
</sc-if>
</sc-for>
</div>
</div></section>
'''.replace('@@LED@@',''.join(excard(e) for e in LED))+FOOTER
data="const EX = "+json.dumps([dict(navn=e[0],rolle=e[1],tekst=e[2],bilde=U(e[3]),omr=e[4]) for e in EXP],ensure_ascii=False)+";\nconst F=['','salg','ledelse','kultur','ki'];"
vals='''    o.kort = EX.map((e) => ({ ...e, vis: s.f === 0 || e.omr.split(" ").indexOf(F[s.f]) >= 0 }));
    [0,1,2,3,4].forEach((i) => { o["f"+i] = "pill" + (s.f === i ? " on" : ""); o["g"+i] = () => this.setState({ f: i }); });'''
open("Fagekspertene.dc.html","w").write(ov+script(3800,", f: 0",vals,data))

# ---------- MAL ----------
e=EX[0]
byname={x[0]:x for x in EX}
REL=[byname[n] for n in ["Leif Ottesen","Janick Løwe","Per Christian Svae"]]
LI='<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11.5H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.82-2.06 3.75-2.06 4 0 4.74 2.64 4.74 6.07v5.89h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4z"/></svg>'
ml=head("Fagekspert")+HEADER
ml+='''<div class="wrap" style="padding-top:32px"><p style="font-size:15px;line-height:20px;color:#566B76"><a href="Fagekspertene.dc.html" style="text-decoration:none">Fagekspertene</a> / %s</p></div>
<section class="ph-hero"><svg aria-hidden="true" viewBox="0 0 700 700" class="ph-x"><line x1="80" y1="80" x2="620" y2="620" stroke="#E4ECE8" stroke-width="130"/><line x1="620" y1="80" x2="80" y2="620" stroke="#E4ECE8" stroke-width="130"/></svg>
<div class="wrap ph-g">
<div class="snitt" style="width:300px"><img src="%s" alt="%s" style="height:375px;clip-path:polygon(0 0,calc(100%% - 44px) 0,100%% 44px,100%% 100%%,0 100%%)"><span class="dot" style="width:22px;height:22px"></span></div>
<div>
<p class="ph-r">%s</p>
<h1 class="ph-n">%s</h1>
<p class="ph-v">Leder Excellerate. Gjør kundenes stemme om til konkrete utviklingsplaner for salg og ledelse.</p>
<div style="margin-top:28px"><a class="chip" href="#">Salgsutvikling</a><a class="chip" href="#">Lederutvikling</a><a class="chip" href="#">Organisasjonsutvikling</a><a class="chip" href="#">GAP Vision</a></div>
</div></div></section>

<div class="wrap ph-body">
<div class="ph-main">
<section><h2>Om Per Kjetil</h2>
<p>Per Kjetil Parr har siden starten av 1990-tallet stått i front for det som har vært Norges største og mest kjente miljø for kompetanseheving innen salg, ledelse og organisasjonsutvikling. Han var med på oppstarten av Euro Business School og viderefører nå dette arbeidet som leder av Excellerate.</p>
<p>Han er kjent for å kombinere tung faglig innsikt med en svært praktisk tilnærming, og er opptatt av hva som virker i virkeligheten, for kunder, medarbeidere og ledere.</p>
<details><summary>Les mer</summary><p>Han har vært sentral i utviklingen av Excellerates metodikk og verktøy for kundedrevet kompetanseutvikling, der kundeopplevelse, prestasjoner og beste praksis fra de beste utøverne i organisasjonen kobles til konkrete utviklingsplaner og lederverktøy. Arbeidet har resultert i mange langsiktige samarbeid med større virksomheter som ville profesjonalisere salgs- og leveranseverdikjedene sine.</p></details></section>

<section><h2>Dette hjelper Per Kjetil med</h2>
<a class="hj" href="#"><b>Kundedrevet kompetanseutvikling</b><span>Kundens stemme styrer hva som prioriteres. Organisasjonen lærer av de beste i egen virksomhet.</span><i class="pil"></i></a>
<a class="hj" href="#"><b>Utviklingsplaner for ledere</b><span>Konkrete grep ledere kan bruke i sine team.</span><i class="pil"></i></a>
<a class="hj" href="#"><b>Salgs- og leveranseverdikjeder</b><span>Profesjonalisering i større virksomheter, over tid.</span><i class="pil"></i></a>
</section>

<section><h2>I korte trekk</h2>
<div class="kt">
<div><b>Tidlig 1990-tall</b><span>Med på oppstarten av Euro Business School</span></div>
<div><b>1996 til 2021</b><span>Eier av Euro Business School</span></div>
<div><b>Fra 2023</b><span>Administrerende direktør i Excellerate</span></div>
<div><b>I dag</b><span>Styreleder i Excellerate AS og Gap Vision AS</span></div>
</div></section>

<section><h2>Aktuelt</h2>
<a class="akt" href="#"><span class="ty">3. juni</span><b>GAP Vision AI lansert sammen med Computas</b><span>Salgsorganisasjoner mister verdi når toppselgernes kunnskap blir hos noen få. Verktøyet gjør den kunnskapen synlig, delbar og målbar.</span></a>
</section>

</div>

