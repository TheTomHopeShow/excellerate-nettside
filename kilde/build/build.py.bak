fs=fs.replace("@@K1@@","/_blob/6aee73de7614899efc4561a8f50ec8d6").replace("@@K2@@","/_blob/db80b62da762e5e37fd701b9e92157de").replace("@@K3@@","/_blob/0a081d31223ec6fa18fe5a9f2aa94d8b").replace("@@K4@@",U(IMG["salg"])).replace("@@CASEIMG@@",U(IMG["thon"])).replace("@@HERO@@",U(IMG["hero"])).replace("@@LOGOS@@",logos())
fs=fs.replace("@@INGANGER@@",
