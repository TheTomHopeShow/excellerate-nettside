<div class="mc"><h4>Tjenester</h4><a href="#">Salgsutvikling</a><a href="#">Lederutvikling</a><a href="#">Kulturutvikling</a><a href="#">KI, adopsjon og sikkerhet</a></div>
<div class="mc"><h4>Mer</h4><a href="#">Bransjer</a><a href="Fagekspertene.dc.html">Fagekspertene</a><a href="#">Kunnskap</a><a href="#">Referanser</a><a href="#">Om oss</a></div>
</div>
</div>
</header>
'''.replace("@@NAV@@",TJ+BR+FA+KU+RE+OM).replace("@@SOK@@",SOK).replace("@@LOGO@@",LOGO).replace("@@MENYX@@",menyx()).replace("@@K2@@","/_blob/db80b62da762e5e37fd701b9e92157de")
FOOTER='''<section id="samtale" class="dyp" style="background:#1B3A4B;color:#fff"><div class="wrap" style="padding-top:88px;padding-bottom:88px;display:flex;justify-content:space-between;align-items:center;gap:48px;flex-wrap:wrap">
<div style="max-width:30em"><h2 style="font-size:40px;line-height:46px;font-weight:500">La oss ta en samtale om hva som mangler for at dere skal lykkes</h2><p style="margin-top:16px;font-size:21px;line-height:32px;color:#D3DCDF">Ring oss på +47 22 49 00 00 eller skriv til post@excellerate.no.</p></div>
<a class="xl-btn-p xl-btn-g" href="#">Book en samtale</a>
</div></section>
<footer class="dyp fl" style="background:#1B3A4B;color:#fff;border-top:1px solid #294F67"><div class="wrap" style="padding-top:56px;padding-bottom:56px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;font-size:16px;line-height:24px">
<div><img src="@@LOGOH@@" alt="Excellerate" style="height:22px;display:block"><p style="margin-top:20px;color:#D3DCDF;max-width:22em">Vi hjelper deg å finne, vinne og beholde de rette kundene.</p></div>
<div><a href="#">Salgsutvikling</a><a href="#">Lederutvikling</a><a href="#">Kulturutvikling</a><a href="#">KI og sikkerhet</a></div>
<div><a href="#">Referanser</a><a href="Fagekspertene.dc.html">Fagekspertene</a><a href="#">Kunnskapssenter</a></div>
<div><a href="#">Om oss</a><a href="#">Kontakt</a><a href="#">Personvern</a></div>
</div></footer>
</div>
</x-dc>
'''.replace("@@LOGOH@@",LOGOH)
def script(h,extra_state="",extra_vals="",extra_data=""):
    return '''<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1440,"height":%d}}'>
%s
class Component extends DCLogic {
  constructor(props) { super(props); this.state = { meny: false%s }; }
  renderVals() {
    const s = this.state;
    const o = {
      menyAapen: s.meny ? "true" : "false",
      menyTekst: s.meny ? "Lukk" : "Meny",
      toggleMeny: () => this.setState({ meny: !s.meny }),
      menyStil: s.meny ? "position:absolute;left:0;right:0;top:80px;background:#fff;border-bottom:1px solid #D3DCDF" : "display:none"
    };
%s
    return o;
  }
}
</script>
</body>
</html>'''%(h,extra_data,extra_state,extra_vals)
LOGOS2=[('dn', '75986caba0dfad1f626e6001440ce741'), ('ramirent', '073f67801711f3af9361815c73c48e45'), ('maxbo', '4fc5e3edfd43e5b30c5455dd7be5421a'), ('olivia', 'dcf3b4b9a0cbf12e3cd25d5762a539a5'), ('synsam', 'b7a727122b1f97cd786a6510795368b2'), ('polarn', 'f56939b7a719714c010de083d098e7d0'), ('thon', '14f9860af6633694b8167ae0b25622da'), ('boligpartner', 'd121a342e1c6cbabb2e7f27a679b3aea'), ('wikborg', '358607f0e262168a2eaa554fc54d3ff9'), ('fargerike', '3c96c29276610052d23e75b81adb13f1'), ('ferda', 'e71907b8a83cee7f30ad2ea6f694973d'), ('tv2', '8dad736121cdd657464d2f81f1f449ad'), ('ark', 'fbfd2783dd56195ebf28a32f7b62050c'), ('ruter', 'd7e797615a7b33627569773b14cc8cb5'), ('hertz', '6dfe181ef2bf7c9b751447484960330c'), ('extra', '8a8dba666d1dc28ff1fb7d0c4f267c56')]
NM={'dn': 'Dagens Næringsliv', 'ramirent': 'Ramirent', 'maxbo': 'Maxbo', 'olivia': 'Olivia', 'synsam': 'Synsam', 'polarn': 'Polarn O. Pyret', 'thon': 'Thon Hotels', 'boligpartner': 'BoligPartner', 'wikborg': 'Wikborg Rein', 'fargerike': 'Fargerike', 'ferda': 'Ferda', 'tv2': 'TV 2', 'ark': 'Ark', 'ruter': 'Ruter', 'hertz': 'Hertz', 'extra': 'Coop Extra'}
def logos():
    def row(items,cls):
        t="".join('<div class="lg2"><img src="%s" alt="%s"></div>'%(U(i),NM[n]) for n,i in items)
        return '<div class="lrow %s"><div class="ltrack">%s%s</div></div>'%(cls,t,t)
    return row(LOGOS2[:8],"")+row(LOGOS2[8:],"r")
def excard(e,cls="ex"):
    if e[3]:
        pt='<div class="pt"><div class="pi"><img src="%s" alt="%s"></div><span class="dot"></span></div>'%(U(e[3]),e[0])
    else:
        pt='<div class="pt"><div class="ph" role="img" aria-label="Bilde mangler"><span>TH</span></div><span class="dot"></span></div>'
    return '''<a class="%s" href="Fagekspert.dc.html">%s<div class="tx"><h3>%s</h3><p class="r">%s</p><p class="t">%s</p></div><span class="lk"><span class="lesl">Les mer<span class="pil"></span></span></span></a>'''%(cls,pt,e[0],e[1],e[2])
def inngang(img,tittel,omr):
    return '''<a class="ing" href="#"><span class="io">%s</span><h3>%s</h3><span class="lesl">Se hva som mangler<span class="pil"></span></span></a>'''%(omr,tittel)
def case(img,t,r,k):
    return '''<a class="cs" href="#"><div class="snitt"><img src="%s" alt="" style="height:260px"><span class="dot"></span></div><h3>%s</h3><p class="cr">%s</p><p class="ck">%s</p><span class="xl-lenke">Les caset<span class="pil"></span></span></a>'''%(U(IMG[img]),t,r,k)

# ---------- FORSIDE ----------
fs=head("Excellerate forside")+HEADER
fs+='''<section class="dyp hero" style="position:relative;overflow:hidden;background:#1B3A4B;color:#fff">
<svg aria-hidden="true" viewBox="0 0 700 700" style="position:absolute;right:-120px;top:-40px;width:780px;height:780px"><line x1="80" y1="80" x2="620" y2="620" stroke="#294F67" stroke-width="150"/><line x1="620" y1="80" x2="80" y2="620" stroke="#294F67" stroke-width="150"/></svg>
<div class="wrap" style="position:relative;padding-top:80px;padding-bottom:88px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
<div>
<h1 style="font-size:56px;line-height:62px;font-weight:600;letter-spacing:-0.02em">Hvem vil dere vinne neste gang?</h1>
<p style="margin-top:28px;font-size:21px;line-height:32px;font-weight:500;color:#D3DCDF;max-width:30em">Excellerate hjelper ledere med å styrke konkurransekraften gjennom salgsutvikling og lederutvikling. Vi finner, vinner og beholder flere kunder sammen med dere. Siden 1988.</p>
<div style="margin-top:40px;display:flex;gap:20px;flex-wrap:wrap;align-items:center"><a class="xl-btn-p xl-btn-g" href="#samtale">Book en samtale</a><a class="xl-lenke lys" href="#mangler" style="font-size:18px">Hva mangler hos dere?<span class="pil"></span></a></div>
</div>
<div class="snitt"><img src="@@HERO@@" alt="Mann i samtale med kolleger" style="height:520px;clip-path:polygon(0 0,calc(100% - 48px) 0,100% 48px,100% 100%,0 100%)"><span class="dot" style="width:24px;height:24px"></span></div>
</div>
</section>
<section style="background:#F3F6F5;overflow:hidden"><div class="wrap" style="padding-top:64px;padding-bottom:28px"><h2 style="font-size:32px;line-height:38px;font-weight:500">Takk for tilliten</h2><p style="margin-top:8px;font-size:19px;line-height:28px;color:#566B76;max-width:34em">Noen av virksomhetene vi har fått lov til å jobbe sammen med.</p></div>
<div class="lrows">@@LOGOS@@</div><div style="height:64px"></div></section>
<section id="mangler" class="sec"><div class="wrap">
<h2 style="font-size:40px;line-height:46px;font-weight:500;max-width:18em">Hva mangler for at dere skal lykkes?</h2>
<p style="margin-top:16px;font-size:21px;line-height:32px;font-weight:500;color:#566B76;max-width:34em">Gjør dere det dere alltid har gjort, får dere det dere alltid har fått. Velg det som ligner mest på deres hverdag.</p>
<div class="g4" style="margin-top:56px">@@INGANGER@@</div>
</div></section>
<section class="dyp" style="background:#1B3A4B;color:#fff"><div class="wrap" style="padding-top:88px;padding-bottom:88px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
<div><span style="display:block;width:18px;height:18px;border-radius:50%;background:#7EA257;margin-bottom:28px"></span>
<p style="font-size:26px;line-height:36px;font-weight:500">«Vi har skapt nye verdier, etablert nye informasjonskanaler og har fått et eget årshjul med tiltak for å bygge kultur.»</p>
<p style="margin-top:24px;font-size:15px;line-height:20px;color:#D3DCDF">Thomas Fehn, konserndirektør IT og digitalisering, Saint-Gobain Distribution</p></div>
