LOGOS=[("5fb1805e66ec06e9da6eb737c86b1dd1","Dagens Næringsliv"),("dd0f6b3dbe64a82c946f35c6b139f8e1","Ramirent"),("07681bab1fcd02ca044f0e71633bfed6","Maxbo"),("9e079bec0053b60b96938fc4f0a7612a","Olivia"),("38f37a9f227f07e59481096aa4ba85ad","Synsam"),("89f98f465394b5fb5c744e31f07b416b","Polarn O. Pyret")]
