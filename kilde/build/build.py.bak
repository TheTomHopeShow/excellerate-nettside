MENYC="".join(sirkel(e) for e in [EX[0],EX[1],EX[2],TOM,EX[3],EX[4],EX[5],EX[6]])
FA=ni("Fageksperter",'<div class="mg" style="grid-template-columns:240px 1fr">'+lead("Fagekspertene","Ett team med erfaring fra salg, ledelse og kultur.","Se alle fagekspertene","Fagekspertene.dc.html")+'<div class="mrow4 sir">'+MENYC+'</div></div>',"Fagekspertene.dc.html")
def kk(t,items):
    return '<div class="mcol kk"><p class="kt">%s</p>%s</div>'%(t,"".join('<a href="#">%s</a>'%i for i in items))
KU=ni("Kunnskap",'<div class="mg" style="grid-template-columns:240px repeat(3,1fr) 300px;gap:36px">'+lead("Kunnskapssenter","Artikler, guider og arrangementer fra fagekspertene.","Åpne kunnskapssenteret")
 +kk("Les",["Artikler","Fagartikler"])+kk("Lær",["Guider","Webinarer og arrangementer"])+kk("Hold deg oppdatert",["Nyhetsbrev","Siste fra fagekspertene"])
 +'<a class="mcard" href="#"><span class="mi"><img src="/_blob/db80b62da762e5e37fd701b9e92157de" alt=""></span><i>Guide</i><b>Rådgivende verdisalg: prinsipper og beste praksis i B2B-salg</b></a></div>')
