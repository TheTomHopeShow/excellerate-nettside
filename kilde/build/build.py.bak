 +ccard("thon","Thon Hotels: et kommersielt kulturløft")+ccard("bolig","BoligPartner: leder- og salgsutvikling")+ccard("wik","Wikborg Rein: forenklet kompetanseutvikling")+'</div>')
OM=ni("Om oss",'<div class="mg" style="grid-template-columns:240px 1fr 1fr 1fr 300px;gap:36px">'+lead("Om oss","Vi hjelper deg å finne, vinne og beholde de rette kundene – og å bygge organisasjonen som klarer det, dag etter dag.","Les mer om oss")
 +kk("Om Excellerate",["Om oss","Vår historie – siden 1988","Verdier","Partnere"])
 +kk("Mennesker",["Fagekspertene","Karriere"])
 +'<div class="mcol kk"><p class="kt">Kontakt</p><a href="#">Kontakt oss</a><span class="ad">Stortorvet 7, Oslo<br>+47 22 49 00 00<br>post@excellerate.no</span></div>'
 +'<a class="mcard" href="#"><span class="mi"><img src="/_blob/6c10bbc2090df8189f1fdb57970dafa0" alt=""></span><b>Besøk oss på Stortorvet 7</b></a></div>')
SOK_SUG=["Når kundene bare snakker om pris","Strategi til handling","AI Act","Rådgivende verdisalg"]
SOK='<div class="sok"><div class="wrap"><div class="sf"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#356A89" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg><input id="sinp" type="search" placeholder="Søk i tjenester, caser og fagekspertene" aria-label="Søk"></div><div class="sg"><div class="sl"><p class="kt">Vanlige søk</p>'+"".join('<a class="chip" href="#">%s</a>'%c for c in SOK_SUG)+'</div><div><p class="kt">Fagekspertene</p><div class="sirk">'+"".join('<a class="scard" href="Fagekspert.dc.html" data-n="%s"><span class="sc"><img src="%s" alt=""></span><b>%s</b></a>'%((e[0]+" "+e[1]).lower(),U(e[3]),e[0]) for e in [EX[0],EX[1],EX[2],TOM,EX[3],EX[4],EX[5],EX[6],EX[7],EX[8]])+'</div></div></div></div></div>'
HEADER='''<header class="hdr"><input type="checkbox" id="sk" class="skx" aria-hidden="true">
<div class="wrap" style="display:flex;align-items:center;justify-content:space-between;height:80px;gap:24px">
<a href="Forside.dc.html" aria-label="Excellerate, til forsiden"><img src="@@LOGO@@" alt="Excellerate" style="height:22px;display:block"></a>
