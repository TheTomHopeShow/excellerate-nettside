STEG='''const STEG = [
 {t:"Innsikt og fakta",x:"Vi starter med å forstå hvor dere står, før vi foreslår noe. Fakta fra kunder, selgere og ledere gir et felles utgangspunkt.",d:"Et felles faktagrunnlag. En tydelig beskrivelse av hva som mangler."},
 {t:"Rådgivning og metodeverk",x:"Metoder og verktøy tilpasset deres marked og deres folk. Vi bygger det sammen med dere, ikke over hodet på dere.",d:"Et metodeverk som passer dere. Valg dere kan stå inne for."},
 {t:"Kompetanseheving og implementering",x:"Systematisk opplæring og støtte, helt til det virker i hverdagen. Det er her endringen blir varig.",d:"Ferdigheter som brukes. Oppfølging til resultatene kommer."}
];'''
vals='''    const st = s.steg;
    o.stegTittel = STEG[st].t; o.stegTekst = STEG[st].x; o.stegDere = STEG[st].d;
    [0,1,2].forEach((i) => { o["c"+i] = "st" + (st === i ? " on" : ""); o["v"+i] = () => this.setState({ steg: i }); });'''
fs+=script(5600,", steg: 0",vals,STEG)
open("Forside.dc.html","w").write(fs)

# ---------- OVERSIKT ----------
ov=head("Fagekspertene")+HEADER
ov+='''<section class="dyp" style="background:#1B3A4B;color:#fff;position:relative;overflow:hidden">
<svg aria-hidden="true" viewBox="0 0 700 700" style="position:absolute;right:-100px;top:-120px;width:640px;height:640px"><line x1="80" y1="80" x2="620" y2="620" stroke="#294F67" stroke-width="130"/><line x1="620" y1="80" x2="80" y2="620" stroke="#294F67" stroke-width="130"/></svg>
