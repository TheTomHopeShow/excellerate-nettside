def head(title):
    return '''<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<title>%s</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
%s
</style>
</helmet>
<div style="width:100%%;background:#fff;position:relative">
'''%(title,CSS)
def kort(e):
    return '<a class="mcard" href="Fagekspert.dc.html"><span class="mi p"><img src="%s" alt=""></span><b>%s</b><i>%s</i></a>'%(U(e[3]),e[0],e[1])
def menyx():
    return "".join(kort(e) for e in LED)
def ccard(img,t):
    return '<a class="mcard" href="#"><span class="mi"><img src="%s" alt=""></span><b>%s</b></a>'%(U(IMG[img]),t)
def kol(t,items):
    return '<div class="mcol"><a class="mh" href="#">%s</a>%s</div>'%(t,"".join('<a href="#">%s</a>'%i for i in items))
def lead(t,p,l,href="#"):
    return '<div class="ml"><h3>%s</h3><p>%s</p><a class="xl-lenke" href="%s">%s<span class="pil"></span></a></div>'%(t,p,href,l)
def ni(t,inner,href="#"):
    return '<div class="ni"><a href="%s">%s</a><div class="mega"><div class="wrap">%s</div></div></div>'%(href,t,inner)
TJ=ni("Tjenester",'<div class="mg" style="grid-template-columns:280px repeat(4,1fr)">'+lead("Tjenester","Fire områder som henger sammen. Velg der dere trenger mest.","Se alle tjenester")
 +kol("Salgsutvikling",["Rådgivende verdisalg","Kunstig intelligens i salg","Salgsledelse","Kundeinnsikt"])
 +kol("Lederutvikling",["Strategi til handling","Coaching","Organisasjonsutvikling"])
 +kol("Kulturutvikling",["Prestasjonskultur","Kommersiell kultur"])
 +kol("KI, adopsjon og sikkerhet",["AI Act og compliance","KI i hverdagen","Informasjonssikkerhet"])+'</div>')
def vert(img,t,items):
    return '<div class="vcard"><a class="vi" href="#"><img src="%s" alt=""></a><a class="vh" href="#">%s</a>%s</div>'%(img,t,"".join('<a href="#">%s</a>'%i for i in items))
BR=ni("Bransjer",'<div class="mg" style="grid-template-columns:240px repeat(4,1fr)">'+lead("Bransjer","Fire vertikaler med egne landingssider. KI-tilbudet gjelder alle fire.","Se alle bransjer")
 +vert(U(IMG["salg"]),"Handel og forhandlernett",["Retail og faghandel","Bil"])
 +vert("/_blob/6aee73de7614899efc4561a8f50ec8d6","Bank, forsikring og eiendomsmegling",["Sparebank","Forsikring","Megling"])
 +vert("/_blob/db80b62da762e5e37fd701b9e92157de","Bygg og eiendom",["Entreprenør og anlegg","Tekniske fag","Utleie og drift"])
 +vert("/_blob/0a081d31223ec6fa18fe5a9f2aa94d8b","IT og teknologi",["Programvare","Konsulent","Drift"])+'</div>')
